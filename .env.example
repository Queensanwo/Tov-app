# Copy to .env for local dev. Never commit .env
DATABASE_URL=postgres://tov:tov_dev_password@localhost:5433/tov
REDIS_URL=redis://localhost:6379

# Auth (Clerk or Auth0 — fill when chosen)
AUTH_PROVIDER=clerk
AUTH_SECRET=replace-me

# YouTube
YOUTUBE_API_KEY=replace-me
YOUTUBE_CLIENT_ID=replace-me
YOUTUBE_CLIENT_SECRET=replace-me

# AI (review pipeline)
AI_API_KEY=replace-me

# Storage
S3_BUCKET=tov-dev
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
